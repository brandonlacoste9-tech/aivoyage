# App
NEXT_PUBLIC_APP_URL=https://trip-planner.co

# Supabase (required for auth + data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Legacy JWT "anon" key OR new "sb_publishable_..." key (Project Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...or.eyJ...
# Service role / secret — server only (webhooks). Never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_... or eyJ...

# xAI Grok — preferred for itineraries + chat (server only)
XAI_API_KEY=
# Optional model override (default: grok-4.5)
# XAI_MODEL=grok-4.5

# Anthropic Claude — optional fallback if no XAI_API_KEY
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Mapbox — optional (map placeholder without it)
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_ACCESS_TOKEN=

# WeatherAPI.com — optional
WEATHER_API_KEY=

# Stripe — Pro subscription ($12/mo)
# Product: Trip Planner Pro (prod_Ux1mG3NPCZeO9V)
# Create keys: https://dashboard.stripe.com/apikeys
# Webhook: https://dashboard.stripe.com/webhooks → https://trip-planner.co/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.created|updated|deleted, invoice.paid, invoice.payment_failed
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_PRICE_PRO=price_1Tx7j8CzqBvMqSYFafnKmKJS

# Resend — optional
RESEND_API_KEY=
RESEND_FROM=Trip Planner <onboarding@trip-planner.co>

# PostHog — optional
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
