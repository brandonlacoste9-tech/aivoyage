# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required for auth + data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role — server only, for Stripe webhooks
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# xAI Grok — preferred for itineraries + chat (server only)
XAI_API_KEY=
# Optional model override (default: grok-4.5)
# XAI_MODEL=grok-4.5

# Anthropic Claude — optional fallback if no XAI_API_KEY
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Mapbox — optional (map placeholder without it)
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_ACCESS_TOKEN=

# WeatherAPI.com — optional
WEATHER_API_KEY=

# Stripe — optional (billing page shows config error without it)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO=price_xxx

# Resend — optional
RESEND_API_KEY=
RESEND_FROM=VoyageAI <onboarding@resend.dev>

# PostHog — optional
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
